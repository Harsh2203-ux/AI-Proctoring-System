# ============================================================
# AI-Powered Secure Online Examination & Proctoring System
# Vercel + PostgreSQL Environment Variables
# ============================================================
# Copy this file to .env (root) and fill in values.
# Set ALL of these as Vercel Environment Variables in the dashboard.
# Never commit the filled-in .env to version control.

# ── Database ──────────────────────────────────────────────
# Neon serverless Postgres connection string
# Get from: https://neon.tech  OR  Vercel > Storage > Connect
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-to-something-long-and-random

# ── App behaviour ─────────────────────────────────────────
# DEMO_MODE=true  → simulated AI proctoring (no real models needed — default)
# DEMO_MODE=false → reserved for future real AI integration
DEMO_MODE=true

# Maximum face-enrollment image size in MB
MAX_UPLOAD_SIZE_MB=10

# ── Demo seed accounts ─────────────────────────────────────
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin@1234
STUDENT_EMAIL=student@demo.com
STUDENT_PASSWORD=Student@1234

# ── Admin registration protection ─────────────────────────
# Required to create new administrator accounts via the registration form.
# Keep this secret — never expose in frontend code or version control.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_REGISTRATION_CODE=replace-with-long-random-secret

# ── Legacy (local FastAPI backend only — not used by Vercel) ──
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=proctoring_db
# AI_SERVICE_URL=http://localhost:8001
# CORS_ORIGINS=http://localhost:5173
