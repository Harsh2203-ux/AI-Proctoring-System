# ============================================================
# AI-Powered Secure Online Examination & Proctoring System
# Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-string-in-production

# --- JWT ---
JWT_SECRET=change-this-jwt-secret-to-something-secure
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=proctoring_db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Service ---
AI_SERVICE_URL=http://ai-service:8001
# Set DEMO_MODE=true to use simulated AI responses (no real models needed)
# Set DEMO_MODE=false to use real AI models (requires model downloads)
DEMO_MODE=true

# --- Evidence Storage ---
EVIDENCE_STORAGE_PATH=/app/evidence
MAX_UPLOAD_SIZE_MB=10

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute

# --- Demo Seed Data ---
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin@1234
STUDENT_EMAIL=student@demo.com
STUDENT_PASSWORD=Student@1234

# --- Real AI Providers (only needed when DEMO_MODE=false) ---
# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base
# YOLO model path (leave empty to auto-download yolov8n.pt)
YOLO_MODEL_PATH=
# pyannote auth token (required for speaker diarisation)
PYANNOTE_AUTH_TOKEN=
